		{"id":"f137d85c3671f024","x":-180,"y":-240,"width":250,"height":100,"type":"text","text":"Elemental Overlay System\nSubtitle: Energetic Modifiers of Signal Motion.\n"},
		{"id":"fcd064101f051d51","x":-180,"y":-100,"width":250,"height":60,"type":"text","text":"Definition\n“Parallel classification axis describing the energetic flavor of a signal.\nOverlays modify how a signal moves, not where it lives.”"},
