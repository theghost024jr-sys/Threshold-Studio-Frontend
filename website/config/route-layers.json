  "layers": [
    {
      "id": "edge",
      "order": 0,
      "label": "Worker edge",
      "note": "Intercepted before assets: canonical redirects and sealed build output."
    },
    {
      "id": "spine",
      "order": 1,
      "label": "The Spine",
      "note": "canonicalEntryPath: the five acts the site itself points through."
    },
    {
      "id": "configured",
      "order": 2,
      "label": "Configured surface",
      "note": "Declared by world topology, spokes or living-pages config."
    },
    {
      "id": "portal",
      "order": 3,
      "label": "Portal SPA",
      "note": "One document shell; the router selects the page."
    },
    {
      "id": "world",
      "order": 4,
      "label": "World SPA",
      "note": "Served the Portal shell by the Worker, but sourced outside website/portal."
    },
    {
      "id": "legacy",
      "order": 5,
      "label": "Legacy",
      "note": "Compatibility or retired-construct surfaces, kept addressable."
    },
    {
      "id": "artifact",
      "order": 6,
      "label": "Build artifacts",
      "note": "Generated or template output inside the deploy root."
    }
  ],
  "edge": {
    "redirects": [
      {
        "from": "/portal/index.html",
        "to": "/portal/",
        "status": 308
      }
    ],
    "sealed": [
      "/portal-dist/",
      "/generated-pages/",
      "/page-templates/",
      "/echoes/inventory/"
    ],
    "retired": [
      "/hub-return.html"
    ]
  },
